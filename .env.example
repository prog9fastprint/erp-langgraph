# =============================================================
# FastPrint ERP AI Orchestrator Configuration
# =============================================================

# -------------------------------------------------------------
# 0. Service Configuration
# -------------------------------------------------------------
APP_NAME=erp-ai-orchestrator
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jakarta
REQUIRE_USER_TOKEN=false
REQUIRE_SERVICE_KEY=false
INTERNAL_SERVICE_KEY=
MAX_CHECKPOINT_THREADS=500

# -------------------------------------------------------------
# 1. ERP Backend Connection & Timeouts
# -------------------------------------------------------------
# ERP Backend URL (alias: DJANGO_INTERNAL_API_URL)
ERP_BASE_URL=http://127.0.0.1:8000
DEFAULT_COMPANY_ID=1

# Option A: Direct static JWT access token (alias: DJANGO_INTERNAL_SERVICE_KEY)
ERP_API_TOKEN=

# Option B: Auto-login credentials (used if ERP_API_TOKEN is blank or expired)
ERP_USERNAME=admin
ERP_PASSWORD=your_password

# Request Timeout in seconds (for ERP HTTP client & LLM requests)
REQUEST_TIMEOUT_SEC=15

# -------------------------------------------------------------
# 2. LLM Provider Selection: 'openrouter' or 'openai'
# -------------------------------------------------------------
MODEL_PROVIDER=openrouter

# A. OpenRouter (Free tier models / flexible multi-model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# B. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# 3. LangGraph & Tools Settings
# -------------------------------------------------------------
# Set to 'true' to dynamically discover tools via GET /ai/tools/ on startup
USE_DYNAMIC_TOOLS=false

# Set to 'true' to pause execution on write tools for human confirmation (HITL)
ENABLE_HITL_INTERRUPT=false
